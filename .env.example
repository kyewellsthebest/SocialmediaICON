# ---- runtime -----------------------------------------------------------
ENV=dev                          # dev | prod  (prod refuses license=none on ingest)
DASHBOARD_TOKEN=                 # REQUIRED in prod - the dashboard is public without it

# ---- infrastructure (Railway provides the first two) -------------------
DATABASE_URL=
REDIS_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- models / providers ------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5  # detect + rank. Titles use Haiku automatically.
# ANTHROPIC_EFFORT=high

TRANSCRIBE_PROVIDER=assemblyai   # assemblyai | deepgram
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# ---- trend scouting (free) ---------------------------------------------
YOUTUBE_API_KEY=                 # Google Cloud -> YouTube Data API v3
SCOUT_ENABLED=true
SCOUT_KEYWORDS=                  # comma separated, e.g. "kettlebell form,home workout mistakes"
SCOUT_INTERVAL_MINUTES=360       # every 6h. Hourly burns quota for no extra signal.
SCOUT_VIDEO_DURATION=medium      # short (<4m) | medium (4-20m) | long (>20m)
SCOUT_REGION=                    # optional ISO country code, e.g. GB
SCOUT_TRACK_LIMIT=30
DEFAULT_NICHE=general

# ---- publishing --------------------------------------------------------
PUBLISHER=manual                 # manual | youtube | upload_post
AUTOPOST_ENABLED=false           # leave off until the clips are good
AUTOPOST_PER_DAY=10
METRICS_INTERVAL_MINUTES=60

# YouTube Shorts, posted with your own OAuth app (free)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Reseller: TikTok without the audit, plus Instagram / Facebook / Snapchat
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# ---- pipeline tuning ---------------------------------------------------
TOP_N_CLIPS=3
MIN_CLIP_S=15
MAX_CLIP_S=60
WINDOW_MINUTES=6

# PutItUpp — every variable this app reads.
#
# Anything not on this list is not read by anything. If it is set in Railway,
# it is doing nothing and can go.

ENV=prod
DASHBOARD_TOKEN=                 # REQUIRED in prod — the dashboard is public without it

# --- infrastructure ---------------------------------------------------------
DATABASE_URL=                    # Railway Postgres, referenced from the plugin
# No REDIS_URL. There is one service and the daily run happens on a thread
# inside it; if you still have a Redis plugin or worker/scheduler services in
# Railway, they are doing nothing and can go.

# Object storage. Only strictly needed for PUBLISHER=meta, which downloads the
# file from a URL rather than accepting an upload. Everything else posts fine
# from local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- where the video comes from ---------------------------------------------
# The rooms. This is the DEFAULT — the dashboard's Setup tab edits the live
# list and overrides it, and clearing that list hands control back here.
#
# Not optional: blank means site-wide search, and search only exists on the
# JSON routes — the ones a cloud host is refused from. Leave unset to use the
# twenty built into the code, which are chosen for PR attempts, heavy singles,
# skills and fails. Setup shows what each room actually gave back on the last
# run, so prune it there after a week rather than guessing.
REDDIT_SUBREDDITS=
REDDIT_TIME_FILTER=week          # hour|day|week|month|year|all
REDDIT_PER_ROOM=12               # entries read per room per run
REDDIT_MAX_DURATION_S=60         # short-form stops at 60s everywhere
REDDIT_FLOOR_DURATION_S=4
REDDIT_MIN_UPVOTES=500           # only applied on routes that can see a score

# A free script app at reddit.com/prefs/apps. Optional — the feed routes need
# no app — but it is the only route that can search, and it always reports
# vote counts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=putitupp/1.0 (by /u/your-username)

# Six ways in, tried in order until one answers:
#   oauth  json  proxied  reader  mirror  rss
# Blank tries them all. The dashboard's Setup tab measures which work here.
REDDIT_ROUTES=
REDDIT_READER=https://r.jina.ai
REDDIT_READER_KEY=
REDDIT_MIRRORS=                  # blank uses the built-in Redlib list
REDDIT_PROXY=

# Only needed if Reddit starts refusing this host's address.
YTDLP_PROXY=
YTDLP_PROXIES=
YTDLP_MAX_PROXIES_PER_RUN=4

# --- branding ---------------------------------------------------------------
BRAND_WIDTH_SHARE=0.13           # badge width as a share of the video's width
BRAND_INSET_SHARE=0.03           # drop from the top edge, same units; centred across
BRAND_OPACITY=1.0
BRAND_CRF=18                     # 18 is visually lossless

# --- the queue --------------------------------------------------------------
HARVEST_ENABLED=true
HARVEST_INTERVAL_MINUTES=1440    # daily
QUEUE_SIZE=15                    # how many wait their turn

# When reels go out. Five a day, an hour apart, from 7am — so the last lands
# at 11am and the window shuts at noon. Railway runs in UTC, so the timezone
# has to be named: 07:00 UTC is five in the afternoon in Brisbane.
POST_TIMEZONE=Australia/Brisbane
POST_START_HOUR=7
POST_PER_DAY=5
POST_EVERY_MINUTES=60

# The second post: the same video as a square Instagram carousel — a cover
# slide, then the video — half an hour after the reel. A reel goes to the
# Reels surface and a carousel sits in the grid and the feed, so the same clip
# reaches two different sets of eyes without either looking like a repeat.
#
# Instagram fetches each slide from a URL rather than accepting an upload, so
# R2 is genuinely required for this, unlike for a reel.
CAROUSEL_ENABLED=true
CAROUSEL_DELAY_MINUTES=30
CAROUSEL_FRAME_AT_S=1.0          # where the cover still comes from; not 0
CAROUSEL_SWIPE_TEXT=Swipe to watch
CAROUSEL_MAX_ATTEMPTS=4          # then it gives up rather than retrying forever
CAROUSEL_RETRY_MINUTES=15        # times the attempt number: 15, 30, 45...
# How long to stand down when Meta says the publishing limit is spent. Its
# window is 24 hours; asking more often is what spends it.
RATE_LIMIT_WAIT_MINUTES=60

# Ask again on a platform that answered "not now" rather than "no". A reel
# counts as posted the moment ANY platform takes it, so without this a reel
# that went to Facebook and hit Instagram's limit is finished with Instagram
# still owed - and that limit clears on its own within the hour.
#
# Rate limits only. A dead token or a broken file fails the same way forever,
# and retrying those is what spends the limit in the first place.
RETRY_RATE_LIMITED=true
RETRY_WITHIN_HOURS=24

# A hard ceiling on post attempts per 24 hours, checked before the first
# request rather than discovered at the last.
#
# Worth understanding, because posts and requests are not the same number.
# Five reels and five carousels is ten posts a day - well under Instagram's
# twenty-five - but it is thirty write requests, because a reel is a container
# and a publish while a carousel is THREE containers and a publish: each slide
# is fetched separately, then the pair is tied together. A failed attempt
# costs its containers whether or not anything is published, which is how a
# retry loop turned four posts into a spent allowance.
#
# Blank or 0 derives the cap from the schedule: POST_PER_DAY, doubled when
# carousels are on, plus the headroom below. Setup shows what this app has
# actually spent next to what Meta says, so the two can be compared rather
# than guessed at.
INSTAGRAM_DAILY_ATTEMPTS=0
PUBLISH_HEADROOM=4
# The quota readout is itself a request against the quota it reports on, so a
# dashboard left open does not get to ask on every refresh.
QUOTA_CACHE_MINUTES=10

# --- publishing -------------------------------------------------------------
PUBLISHER=manual                 # manual | upload_post | youtube | meta
AUTOPOST_ENABLED=false           # nothing goes out until this is true
#
# There is no list of accounts to fill in. Where a reel goes is derived from
# whichever credentials below are set: INSTAGRAM_USER_ID is the Instagram
# account, THREADS_USER_ID is the Threads one, and so on. The Setup tab shows
# what they resolve to, asking Meta to name each account rather than trusting
# that a variable is non-empty.

# TikTok and Snapchat, via a reseller. One key reaches a dozen platforms, so
# which ones is a decision rather than a credential - unlike the Meta ones,
# where the id IS the account and the destinations are derived from it.
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=
UPLOAD_POST_PLATFORMS=tiktok,snapchat

# YouTube Shorts, with your own free OAuth app
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels / Threads / Facebook, with your own free Meta app
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Threads is a SEPARATE API on graph.threads.net with its own login, and
# META_ACCESS_TOKEN does not work for it. Both of these have to be set or
# Threads is silently left out while Instagram and Facebook post fine.
# THREADS_USER_ID is the Threads account id, not the Instagram one.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
TOKEN_REFRESH_INTERVAL_DAYS=14

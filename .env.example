# ---- runtime -----------------------------------------------------------
ENV=dev                          # dev | prod  (prod refuses license=none on ingest)
DASHBOARD_TOKEN=                 # REQUIRED in prod - the dashboard is public without it

# ---- infrastructure (Railway provides the first two) -------------------
DATABASE_URL=
REDIS_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- models / providers ------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5  # detect + rank. Titles use Haiku automatically.
# ANTHROPIC_EFFORT=high

TRANSCRIBE_PROVIDER=assemblyai   # assemblyai | deepgram
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# ---- trend scouting (free) ---------------------------------------------
YOUTUBE_API_KEY=                 # Google Cloud -> YouTube Data API v3
SCOUT_ENABLED=true
SCOUT_KEYWORDS=                  # comma separated, e.g. "kettlebell form,home workout mistakes"
SCOUT_INTERVAL_MINUTES=360       # every 6h. Hourly burns quota for no extra signal.
SCOUT_VIDEO_DURATION=medium      # short (<4m) | medium (4-20m) | long (>20m)
SCOUT_REGION=                    # optional ISO country code, e.g. GB
SCOUT_TRACK_LIMIT=30

# ---- yt-dlp -----------------------------------------------------------
# YouTube challenges datacenter IPs with "confirm you're not a bot". Which
# player client passes changes every few months, so this is a list tried in
# order. Cookies (from a THROWAWAY account) or a residential proxy are the
# reliable answers.
YTDLP_PLAYER_CLIENTS=tv,web_safari,mweb,android_vr
YTDLP_COOKIES_B64=
YTDLP_PROXY=
DEFAULT_NICHE=general

# ---- publishing --------------------------------------------------------
PUBLISHER=manual                 # manual | youtube | meta | upload_post
AUTOPOST_ENABLED=false           # leave off until the clips are good
AUTOPOST_PER_DAY=10
METRICS_INTERVAL_MINUTES=60

# YouTube Shorts, posted with your own OAuth app (free)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels, Threads and Facebook Reels, posted with your own Meta app
# (free). Meta downloads the clip itself, so R2 must be configured too.
META_GRAPH_VERSION=v23.0
TOKEN_REFRESH_INTERVAL_DAYS=14   # tokens die at 60; refresh well before
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=               # long-lived; expires after 60 days
INSTAGRAM_USER_ID=               # the IG *business* account id, not the handle
# Set this to reach Instagram directly (Instagram Login) instead of through
# a Facebook Page. Use it when the Page is linked to a different IG account.
INSTAGRAM_ACCESS_TOKEN=
# Instagram and Threads each have their own app id/secret, shown on their
# own use case page - they are NOT the Meta app's, and the exchange is
# signed with these.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=             # optional; falls back to META_ACCESS_TOKEN
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=            # a separate token from the Facebook one
THREADS_APP_ID=
THREADS_APP_SECRET=

# Reseller: TikTok without the audit, plus Instagram / Facebook / Snapchat
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# ---- pipeline tuning ---------------------------------------------------
TOP_N_CLIPS=3
MIN_CLIP_S=15
MAX_CLIP_S=60
WINDOW_MINUTES=6

# ---- runtime -----------------------------------------------------------
ENV=dev                        # dev | prod  (prod refuses license=none on ingest)

# ---- infrastructure ----------------------------------------------------
# Leave DATABASE_URL / REDIS_URL / R2_* unset to run the Phase 1 CLI fully
# locally: no rows are written and renders land under ./.storage.
DATABASE_URL=postgresql://user:pass@host:5432/clipengine
REDIS_URL=redis://localhost:6379/0

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- models / providers ------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_EFFORT=high        # low | medium | high | xhigh | max (optional)

TRANSCRIBE_PROVIDER=assemblyai # assemblyai | deepgram
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=

# ---- publishing (Phase 3, not used yet) --------------------------------
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
IG_APP_ID=
IG_APP_SECRET=
IG_TOKEN=

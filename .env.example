# PutItUpp — every variable this app reads.
#
# Anything not on this list is not read by anything. If it is set in Railway,
# it is doing nothing and can go.

ENV=prod
DASHBOARD_TOKEN=                 # REQUIRED in prod — the dashboard is public without it

# --- infrastructure ---------------------------------------------------------
DATABASE_URL=                    # Railway Postgres, referenced from the plugin
REDIS_URL=                       # Railway Redis. Without it a run happens inline
                                 # in the web request, which times out on a full pass.

# Object storage. Only strictly needed for PUBLISHER=meta, which downloads the
# file from a URL rather than accepting an upload. Everything else posts fine
# from local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- where the video comes from ---------------------------------------------
# The rooms. Not optional: blank means site-wide search, and search only exists
# on the JSON routes — the ones a cloud host is refused from. Leave this unset
# to use the twenty-five built into the code.
REDDIT_SUBREDDITS=
REDDIT_TIME_FILTER=week          # hour|day|week|month|year|all
REDDIT_PER_ROOM=12               # entries read per room per run
REDDIT_MAX_DURATION_S=60         # short-form stops at 60s everywhere
REDDIT_FLOOR_DURATION_S=4
REDDIT_MIN_UPVOTES=500           # only applied on routes that can see a score

# A free script app at reddit.com/prefs/apps. Optional — the feed routes need
# no app — but it is the only route that can search, and it always reports
# vote counts.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=putitupp/1.0 (by /u/your-username)

# Six ways in, tried in order until one answers:
#   oauth  json  proxied  reader  mirror  rss
# Blank tries them all. The dashboard's Setup tab measures which work here.
REDDIT_ROUTES=
REDDIT_READER=https://r.jina.ai
REDDIT_READER_KEY=
REDDIT_MIRRORS=                  # blank uses the built-in Redlib list
REDDIT_PROXY=

# Only needed if Reddit starts refusing this host's address.
YTDLP_PROXY=
YTDLP_PROXIES=
YTDLP_MAX_PROXIES_PER_RUN=4

# --- branding ---------------------------------------------------------------
BRAND_WIDTH_SHARE=0.13           # badge width as a share of the video's width
BRAND_INSET_SHARE=0.035          # inset from the top-left corner, same units
BRAND_OPACITY=1.0
BRAND_CRF=18                     # 18 is visually lossless

# --- the queue --------------------------------------------------------------
HARVEST_ENABLED=true
HARVEST_INTERVAL_MINUTES=1440    # daily
QUEUE_SIZE=15                    # how many wait their turn
POST_PER_RUN=8                   # how many go out each run

# --- publishing -------------------------------------------------------------
PUBLISHER=manual                 # manual | upload_post | youtube | meta
AUTOPOST_ENABLED=false           # nothing goes out until this is true

# TikTok and Snapchat, via a reseller
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# YouTube Shorts, with your own free OAuth app
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Instagram Reels / Threads / Facebook, with your own free Meta app
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
TOKEN_REFRESH_INTERVAL_DAYS=14
